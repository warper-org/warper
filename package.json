{
  "name": "@warper-org/warper",
  "version": "5.0.0-quantum",
  "type": "module",
  "private": false,
  "description": "⚡ Ultra-fast React virtualization library - 120+ FPS, 1M+ items, powered by Rust/WASM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warper-org/warper.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run build:wasm && tsc",
    "build:wasm": "cd wasm/rust && wasm-pack build --target web --release",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "example:list": "vite --config examples/list/vite.config.ts",
    "example:grid": "vite --config examples/grid/vite.config.ts",
    "example:one-million-rows": "vite --config examples/one-million-rows/vite.config.ts",
    "example:chat": "vite --config examples/chat/vite.config.ts",
    "example:tree": "vite --config examples/tree/vite.config.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
